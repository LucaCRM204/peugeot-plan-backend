# Base de datos — en Railway, DATABASE_URL se provee automáticamente
# si agregás un servicio MySQL al proyecto. En local, completá las
# variables sueltas de abajo.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peugeot_plan

# Servidor
PORT=4000

# Frontend permitido para CORS (separar con comas si hay más de uno)
FRONTEND_URL=http://localhost:5173

# JWT — generá algo largo y random, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (Dashboard > Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Solo para el script de seed (npm run seed) — no se usan en runtime.
SEED_ADMIN_EMAIL=admin@peugeotplan.com.ar
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Admin
